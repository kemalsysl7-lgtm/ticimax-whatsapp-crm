# Yalnızca anahtar isimleri ve placeholder değerler. Gerçek değerleri .env dosyasına yazın (git'e girmez).

NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://crm:crm@localhost:5432/crm
REDIS_URL=redis://localhost:6379

# Yönetim API'si için geçici statik token (panel girişi gelene kadar). En az 32 karakter.
ADMIN_API_TOKEN=change-me-to-a-long-random-string-000000

# Ticimax
TICIMAX_BASE_URL=https://www.alanadiniz.com
TICIMAX_UYE_KODU=placeholder

# Meta WhatsApp Cloud API
WHATSAPP_GRAPH_API_VERSION=v23.0
WHATSAPP_PHONE_NUMBER_ID=placeholder
WHATSAPP_BUSINESS_ACCOUNT_ID=placeholder
WHATSAPP_ACCESS_TOKEN=placeholder
WHATSAPP_APP_SECRET=placeholder
WHATSAPP_WEBHOOK_VERIFY_TOKEN=placeholder

# Gönderim politikası
TIMEZONE=Europe/Istanbul
QUIET_HOURS_START=21
QUIET_HOURS_END=9
MARKETING_WEEKLY_CAP=2

# Arka plan işleri (kuyruk işleyicileri + senkron zamanlayıcıları) bu süreçte çalışsın mı?
RUN_WORKERS=true
SYNC_INTERVAL_MINUTES=15
