{$DOMAIN} {
	encode gzip

	# Meta webhook'u ve sağlık kontrolü doğrudan sunucuya gider.
	handle /webhooks/* {
		reverse_proxy server:3000
	}
	handle /health {
		reverse_proxy server:3000
	}

	# Yönetim API'si (/admin/*) dışarı açılmaz; panel ona iç ağdan erişir.
	# Geri kalan her şey panele gider.
	handle {
		reverse_proxy panel:3001
	}
}
